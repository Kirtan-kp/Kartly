# Copy to .env and adjust. Never commit .env.
KARTLY_DATABASE_URL=postgresql+psycopg://kartly:kartly@localhost:5432/kartly
KARTLY_REDIS_URL=redis://localhost:6379/0

# LLM provider keys. The names are set in config/models.yaml (api_key_env).
# Groq: free key from console.groq.com. Ollama needs no key.
GROQ_API_KEY=

# API key that callers must send in the X-API-Key header. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KARTLY_API_KEY=
# Which model answers tickets: a name from config/models.yaml (default: first of role "small").
# KARTLY_DEFAULT_MODEL=groq_small

# Optional: let the agent search the policy knowledge base (needs: ollama pull nomic-embed-text).
# KARTLY_KB_DIR=kb
# KARTLY_POLICY_MIN_SCORE=0.67
# KARTLY_CONTEXT_BUDGET_TOKENS=6000
# Optional: a model (name from config/models.yaml) that holds policy replies that say something
# the retrieved text does not. Measure it first: python -m kartly.evals.claims --model NAME
# KARTLY_CLAIM_CHECK_MODEL=groq_small

# Optional: a dedicated *test* database for the Postgres tests.
# The tests DROP and recreate the public schema, so the database name must contain "test".
# KARTLY_TEST_DATABASE_URL=postgresql+psycopg://kartly:kartly@localhost:5432/kartly_test
# How much each write tier may do: off, shadow (a human must approve each write) or auto.
# Tier 1 is low-risk writes (cancel an order); tier 2 is money. Shadow is the default.
# KARTLY_TIER1_MODE=shadow
# KARTLY_TIER2_MODE=shadow
# Refunds above these need a human: total refunded on one order, and per customer per 24 hours.
# KARTLY_REFUND_AUTO_LIMIT_INR=1000
# KARTLY_REFUND_DAILY_CAP_INR=5000

# If the default model keeps failing (down, rate limited), try these next, in order. Comma separated
# names from config/models.yaml. Each model gets LLM_MAX_ATTEMPTS calls (with waiting between), and
# one that fails LLM_FAILURE_THRESHOLD calls in a row is skipped for LLM_COOLDOWN_S seconds.
# KARTLY_FALLBACK_MODELS=groq_large
# KARTLY_LLM_MAX_ATTEMPTS=3
# KARTLY_LLM_FAILURE_THRESHOLD=3
# KARTLY_LLM_COOLDOWN_S=30

# Durable job queue (ADR-052). "inprocess" (default) runs tickets inside the API; "db" writes a job
# that workers pick up, retry with backoff and park as a dead letter when they cannot finish it.
# Needs: alembic upgrade head. Separate worker process: python -m kartly.worker (embedded 0).
# KARTLY_QUEUE_MODE=inprocess
# KARTLY_EMBEDDED_WORKERS=2
# KARTLY_JOB_MAX_ATTEMPTS=3
# KARTLY_JOB_LEASE_S=300
# KARTLY_WORKER_POLL_S=1.0

# Alerts (ADR-055). Rules over the metrics; announced once per change.
# KARTLY_ALERTS_ENABLED=true
# KARTLY_ALERT_INTERVAL_S=60
# KARTLY_ALERT_WINDOW_S=900
# A critical alert may freeze writes or switch the agent off by itself. Off unless you turn it on.
# KARTLY_ALERT_AUTO_ACTIONS=false
# KARTLY_ALERT_WEBHOOK_URL=https://hooks.example/...

