# Copy to .env and adjust. Never commit .env.
KARTLY_DATABASE_URL=postgresql+psycopg://kartly:kartly@localhost:5432/kartly
KARTLY_REDIS_URL=redis://localhost:6379/0

# LLM provider keys. The names are set in config/models.yaml (api_key_env).
# Groq: free key from console.groq.com. Ollama needs no key.
GROQ_API_KEY=

# Optional: a dedicated *test* database for the Postgres tests.
# The tests DROP and recreate the public schema, so the database name must contain "test".
# KARTLY_TEST_DATABASE_URL=postgresql+psycopg://kartly:kartly@localhost:5432/kartly_test
