# Settings for docker-compose.deploy.yml. Copy to .env.deploy (never commit it) and fill in:
#   cp .env.deploy.example .env.deploy
#   docker compose --env-file .env.deploy -f docker-compose.deploy.yml up -d --build
#
# Use letters and digits in the database password: it is placed inside a URL.
# Generate both secrets with:  openssl rand -hex 24

POSTGRES_PASSWORD=
KARTLY_API_KEY=

# Where the API listens on this machine (127.0.0.1 only; put a reverse proxy with https in front).
KARTLY_PORT=8000
# true once the site is served over https, so the sign-in cookie is never sent over http.
KARTLY_COOKIE_SECURE=false

# Model providers. models.yaml names which key each provider needs.
GROQ_API_KEY=
# Ollama running on the host (policy search embeddings and local models):
KARTLY_OLLAMA_URL=http://host.docker.internal:11434

# Optional agent settings (see .env.example for all of them):
# KARTLY_DEFAULT_MODEL=groq_small
# KARTLY_FALLBACK_MODELS=groq_large
# KARTLY_KB_DIR=/app/kb
# KARTLY_ALERT_WEBHOOK_URL=https://example.com/hook

# Only with docker-compose.proxy.yml (https): the DNS name that points at this machine.
# KARTLY_DOMAIN=support.example.com
# Tag for the image, so the previous release stays available to roll back to (see docs/DEPLOY.md).
# KARTLY_IMAGE_TAG=local

